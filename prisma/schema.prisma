generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Resource {
  articles
  videos
  opportunities
  trainings
  events
  hero
}
model Category {
  id        String @id
  resource  Resource
  key       String
  label     String
  metadata  Json @default("{}")
  sortOrder Int @default(0)
  entries   ContentEntry[]
  @@unique([resource, key])
  @@index([resource, sortOrder])
}
model ContentEntry {
  id          String @id @default(cuid())
  resource    Resource
  slug        String
  title       String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  summary     Json
  data        Json
  searchText  String @db.Text
  featured    Boolean @default(false)
  sortOrder   Int @default(0)
  published   Boolean @default(false)
  publishedAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  @@unique([resource, slug])
  @@index([resource, published, sortOrder, publishedAt, id])
  @@index([resource, categoryId, published])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "ContentEntry_searchText_trgm_idx")
}
model SiteSettings {
  id        String @id @default("main")
  data      Json
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}
model TrainingSession {
  id        String @id
  data      Json
  startsAt  DateTime @db.Timestamptz(3)
  published Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([published, startsAt])
}
model AuditLog {
  id        String @id @default(cuid())
  action    String
  resource  String
  target    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([createdAt])
}
model AdminUser {
  id                  String         @id @default(cuid())
  username            String         @unique @db.VarChar(50)
  email               String         @unique @db.VarChar(254)
  displayName         String         @db.VarChar(120)
  passwordHash        String         @db.Text
  active              Boolean        @default(true)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?      @db.Timestamptz(3)
  lastLoginAt         DateTime?      @db.Timestamptz(3)
  passwordChangedAt   DateTime       @default(now()) @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)
  sessions            AdminSession[]
  @@index([active])
}
model AdminSession {
  id          String    @id
  verifierHash String   @db.VarChar(64)
  csrfHash    String    @db.VarChar(64)
  expiresAt   DateTime  @db.Timestamptz(3)
  lastSeenAt  DateTime  @default(now()) @db.Timestamptz(3)
  userAgent   String?   @db.VarChar(500)
  ipHash      String?   @db.VarChar(64)
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  @@index([adminUserId, expiresAt])
  @@index([expiresAt])
}

