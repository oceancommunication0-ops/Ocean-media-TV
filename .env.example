DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
# Clé technique réservée aux scripts d’automatisation serveur.
# Générer au moins 32 caractères aléatoires. Ne jamais utiliser un préfixe VITE_.
ADMIN_API_KEY=replace-with-a-random-secret-of-at-least-32-characters
TRUST_PROXY=0
# Facultatif si frontend et API sont hébergés séparément :
# VITE_API_URL=https://api.example.com/api

